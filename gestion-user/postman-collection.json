              "description": "Admin username"
            },
            {
              "key": "password",
              "value": "admin",
              "description": "Admin password"
            },
            {
              "key": "client_id",
              "value": "my-app-client",
              "description": "Keycloak client ID"
            },
            {
              "key": "client_secret",
              "value": "J8cChqYP81yh9WPSy9UEKkWy85CLj7Bu",
              "description": "Keycloak client secret"
            },
            {
              "key": "grant_type",
              "value": "password",
              "description": "OAuth2 grant type"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:8080/realms/my-app-realm/protocol/openid-connect/token",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["realms", "my-app-realm", "protocol", "openid-connect", "token"]
        },
        "description": "Login admin through Keycloak and get access token"
      }
    },
    {
      "name": "Formateur Login (Keycloak)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "farouk",
              "description": "Formateur username"
            },
            {
              "key": "password",
              "value": "farouk",
              "description": "Formateur password"
            },
            {
              "key": "client_id",
              "value": "my-app-client",
              "description": "Keycloak client ID"
            },
            {
              "key": "client_secret",
              "value": "J8cChqYP81yh9WPSy9UEKkWy85CLj7Bu",
              "description": "Keycloak client secret"
            },
            {
              "key": "grant_type",
              "value": "password",
              "description": "OAuth2 grant type"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:8080/realms/my-app-realm/protocol/openid-connect/token",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["realms", "my-app-realm", "protocol", "openid-connect", "token"]
        },
        "description": "Login formateur through Keycloak and get access token"
      }
    },
    {
      "name": "Get User Info",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8089/users/{keycloak_id}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8089",
          "path": ["users", "{keycloak_id}"],
          "variable": [
            {
              "key": "keycloak_id",
              "value": "user-keycloak-id-here",
              "description": "Keycloak user ID"
            }
          ]
        },
        "description": "Get user information from Python API"
      }
    },
    {
      "name": "Get All Users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8089/users",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8089",
          "path": ["users"]
        },
        "description": "Get all users (if endpoint exists)"
      }
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Add timestamp to requests for debugging",
          "pm.globals.set(\"timestamp\", new Date().toISOString());"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8089",
      "type": "string"
    },
    {
      "key": "keycloak_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_keycloak_id",
      "value": "",
      "type": "string"
    }
  ]
}